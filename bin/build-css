#!/bin/sh
# Builds public/css/app.css with the Tailwind standalone CLI (no Node needed).
set -e
cd "$(dirname "$0")/.."
if [ ! -x bin/tailwindcss ]; then
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) asset=tailwindcss-macos-arm64 ;;
    Darwin-x86_64) asset=tailwindcss-macos-x64 ;;
    Linux-x86_64) asset=tailwindcss-linux-x64 ;;
    Linux-aarch64) asset=tailwindcss-linux-arm64 ;;
    *) echo "unsupported platform"; exit 1 ;;
  esac
  curl -sSL -o bin/tailwindcss "https://github.com/tailwindlabs/tailwindcss/releases/latest/download/$asset"
  chmod +x bin/tailwindcss
fi
exec bin/tailwindcss -i resources/css/app.css -o public/css/app.css --minify "$@"
